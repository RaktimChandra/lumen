{
  "name": "@lumen/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Validation schemas, enums and API types shared by the Lumen API, web app and mobile app.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "vitest": "^5.0.0"
  }
}
