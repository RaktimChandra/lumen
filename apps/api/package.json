{
  "name": "@lumen/api",
  "version": "1.0.0",
  "private": true,
  "description": "Lumen REST API — one backend for the web and mobile apps.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsup",
    "start": "node dist/migrate.js && node dist/server.js",
    "start:server": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "openapi:export": "tsx src/scripts/export-openapi.ts"
  },
  "dependencies": {
    "@lumen/shared": "1.0.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.0",
    "express": "^5.2.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.1.0",
    "supertest": "^7.3.0",
    "tsup": "^8.5.0",
    "tsx": "^4.23.0",
    "vitest": "^5.0.0"
  }
}
