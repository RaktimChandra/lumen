# ---- Server ----
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (Render = 1; Render behind Vercel rewrite = 2).
TRUST_PROXY=1

# ---- Database ----
DATABASE_URL=postgres://lumen:lumen@localhost:5432/lumen
# true | false | auto (auto = TLS unless the host is localhost)
DATABASE_SSL=auto

# ---- Auth ----
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-48-chars-min
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# ---- Browser access ----
# Comma-separated list of web origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173
# strict | lax | none   (none requires HTTPS; only needed if the web app calls the API cross-site)
COOKIE_SAMESITE=strict

# ---- Rate limits ----
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_FAILURES_PER_EMAIL=5
API_RATE_LIMIT_PER_MINUTE=300
